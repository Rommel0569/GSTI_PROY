# Copie este archivo a ".env" y complete los valores reales antes de desplegar
# en producción. Nunca commitee el archivo ".env" real (ya está en .gitignore).

# --------------------------------------------------------------------------
# Notificaciones (Twilio) — Componente E
# --------------------------------------------------------------------------
# MOCK_NOTIFICATIONS=true  -> modo simulación offline, zero costo (por defecto).
# MOCK_NOTIFICATIONS=false -> usa la API real de Twilio (requiere cuenta paga).
MOCK_NOTIFICATIONS=true

# Credenciales de la cuenta Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Número de Twilio verificado para SMS y llamadas de voz (formato E.164, ej. +51999999999)
TWILIO_FROM_NUMBER=

# Remitente de WhatsApp. En sandbox de pruebas: whatsapp:+14155238886
# En producción real: el número de WhatsApp Business del hospital, ya aprobado por Meta.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# SID de la plantilla de WhatsApp (Content API) aprobada por Meta para el
# recordatorio de citas. OBLIGATORIO para enviar WhatsApp fuera de la ventana
# de 24h de conversación con el paciente (regla de Meta, no de Twilio).
# Sin esto, send_whatsapp() solo funcionará dentro del sandbox de pruebas.
TWILIO_WHATSAPP_CONTENT_SID=

# --------------------------------------------------------------------------
# WhatsApp: proveedor alternativo directo con Meta (sin intermediario que
# cobre margen por mensaje). Deje WHATSAPP_PROVIDER=twilio si prefiere seguir
# usando Twilio también para WhatsApp; cambie a "meta_cloud" para usar esto.
# Requiere igual verificación de negocio y plantilla aprobada por Meta.
# --------------------------------------------------------------------------
WHATSAPP_PROVIDER=twilio
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=es_MX

# URL pública (HTTPS) donde queda desplegado app/api.py, usada para construir
# la URL de callback del webhook de DTMF que Twilio invoca durante la llamada.
# Ejemplo: https://noshow-api.tuhospital.pe
PUBLIC_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# Seguridad — RNF-02 (obligatorio antes de exponer el sistema fuera de localhost)
# --------------------------------------------------------------------------
# Clave requerida en el header "X-API-Key" para llamar a app/api.py.
# Genere una clave larga y aleatoria, ej.: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# Contraseña para acceder al dashboard de Streamlit (personal administrativo).
DASHBOARD_PASSWORD=

# --------------------------------------------------------------------------
# Kaggle API (Nivel 2 de data_pipeline.py) — opcional
# --------------------------------------------------------------------------
KAGGLE_USERNAME=
KAGGLE_KEY=
